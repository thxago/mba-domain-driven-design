    { "id": "legend-text", "type": "text", "x": 50, "y": 158, "width": 2100, "height": 25, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 10, "version": 1, "versionNonce": 10, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 3, "text": "Ator                    Comando                 Agregado                Evento de domínio       Política                Integração              Sistema externo         Consulta", "originalText": "Ator                    Comando                 Agregado                Evento de domínio       Política                Integração              Sistema externo         Consulta", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "sales-context", "type": "text", "x": 30, "y": 235, "width": 2100, "height": 60, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 11, "version": 1, "versionNonce": 11, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "CONTEXTO: VENDA DE INGRESSOS\n1. Cancelamento e liberação — o comando altera apenas Order; a liberação é uma reação.", "originalText": "CONTEXTO: VENDA DE INGRESSOS\n1. Cancelamento e liberação — o comando altera apenas Order; a liberação é uma reação.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "cancel-actor", "type": "rectangle", "x": 30, "y": 330, "width": 180, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#ffe7a3", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 12, "version": 1, "versionNonce": 12, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "cancel-actor-text", "type": "text", "x": 45, "y": 350, "width": 150, "height": 100, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 13, "version": 1, "versionNonce": 13, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Cliente\nCustomer\n\nAtor da compra", "originalText": "Cliente\nCustomer\n\nAtor da compra", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "cancel-command", "type": "rectangle", "x": 250, "y": 330, "width": 300, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#a9cfee", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 14, "version": 1, "versionNonce": 14, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "cancel-command-text", "type": "text", "x": 265, "y": 350, "width": 270, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 15, "version": 1, "versionNonce": 15, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "Cancelar pedido pelo ID\nCancelOrderService.cancel(order_id)\nApplicationService.run(...)\n\nNão libera lugar.\nNão promove a fila.", "originalText": "Cancelar pedido pelo ID\nCancelOrderService.cancel(order_id)\nApplicationService.run(...)\n\nNão libera lugar.\nNão promove a fila.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "order", "type": "rectangle", "x": 590, "y": 330, "width": 300, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#cec9bd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 16, "version": 1, "versionNonce": 16, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "order-text", "type": "text", "x": 605, "y": 350, "width": 270, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 17, "version": 1, "versionNonce": 17, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Order — raiz do agregado\n\ncancel()\nPENDING ou PAID → CANCELLED\nProíbe cancelar duas vezes.", "originalText": "Order — raiz do agregado\n\ncancel()\nPENDING ou PAID → CANCELLED\nProíbe cancelar duas vezes.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "order-cancelled", "type": "rectangle", "x": 930, "y": 330, "width": 350, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#f7ceb2", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 18, "version": 1, "versionNonce": 18, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "order-cancelled-text", "type": "text", "x": 945, "y": 350, "width": 320, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 19, "version": 1, "versionNonce": 19, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Pedido cancelado\nOrderCancelled\n\naggregate_id, status,\nevent_spot_id", "originalText": "Pedido cancelado\nOrderCancelled\n\naggregate_id, status,\nevent_spot_id", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "release-handler", "type": "rectangle", "x": 1320, "y": 330, "width": 350, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#c6baff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 20, "version": 1, "versionNonce": 20, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "release-handler-text", "type": "text", "x": 1335, "y": 350, "width": 320, "height": 135, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 21, "version": 1, "versionNonce": 21, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "Reação: liberar lugar\nReleaseSpotOnOrderCancelledHandler\n\nBusca Event pelo spot.\nDelega liberação à raiz.\nRemove SpotReservation.\nPersiste e publica eventos.", "originalText": "Reação: liberar lugar\nReleaseSpotOnOrderCancelledHandler\n\nBusca Event pelo spot.\nDelega liberação à raiz.\nRemove SpotReservation.\nPersiste e publica eventos.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "event", "type": "rectangle", "x": 1710, "y": 330, "width": 350, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#cec9bd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 22, "version": 1, "versionNonce": 22, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "event-text", "type": "text", "x": 1725, "y": 350, "width": 320, "height": 140, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 23, "version": 1, "versionNonce": 23, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "Event — raiz do agregado\nmarkSpotAsAvailable(spot_id)\n\nLocaliza a seção internamente.\nEvent → EventSection → EventSpot\nis_reserved = false\nAPI: reserved = false", "originalText": "Event — raiz do agregado\nmarkSpotAsAvailable(spot_id)\n\nLocaliza a seção internamente.\nEvent → EventSection → EventSpot\nis_reserved = false\nAPI: reserved = false", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "spot-released", "type": "rectangle", "x": 2100, "y": 330, "width": 350, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#f7ceb2", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 24, "version": 1, "versionNonce": 24, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "spot-released-text", "type": "text", "x": 2115, "y": 350, "width": 320, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 25, "version": 1, "versionNonce": 25, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Lugar liberado\nEventSpotReleased\n\nevent_id, section_id, spot_id\nRegistrado pela raiz Event.", "originalText": "Lugar liberado\nEventSpotReleased\n\nevent_id, section_id, spot_id\nRegistrado pela raiz Event.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "reservation", "type": "rectangle", "x": 1320, "y": 555, "width": 350, "height": 95, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#cec9bd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 26, "version": 1, "versionNonce": 26, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "reservation-text", "type": "text", "x": 1335, "y": 570, "width": 320, "height": 70, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 27, "version": 1, "versionNonce": 27, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "SpotReservation — agregado separado\nTrava identificada pelo spot_id.\nRemovida pelo handler de liberação.", "originalText": "SpotReservation — agregado separado\nTrava identificada pelo spot_id.\nRemovida pelo handler de liberação.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "notify-policy", "type": "rectangle", "x": 2100, "y": 710, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#c6baff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 28, "version": 1, "versionNonce": 28, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "notify-policy-text", "type": "text", "x": 2115, "y": 730, "width": 320, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 29, "version": 1, "versionNonce": 29, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "POLÍTICA: lugar liberado →\nnotificar o primeiro pendente\nNotifyWaitingCustomerOnSpotReleasedHandler\n\nBusca fila por evento + seção.\nSem fila/pendentes: nada acontece.\nWaitingList.notifyFirstPending(spot_id)\nPersiste; publica domínio e integração.", "originalText": "POLÍTICA: lugar liberado →\nnotificar o primeiro pendente\nNotifyWaitingCustomerOnSpotReleasedHandler\n\nBusca fila por evento + seção.\nSem fila/pendentes: nada acontece.\nWaitingList.notifyFirstPending(spot_id)\nPersiste; publica domínio e integração.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "waiting-notify", "type": "rectangle", "x": 1710, "y": 710, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#cec9bd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 30, "version": 1, "versionNonce": 30, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "waiting-notify-text", "type": "text", "x": 1725, "y": 730, "width": 320, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 31, "version": 1, "versionNonce": 31, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "WaitingList — raiz separada de Event\nUma fila por event_id + section_id\nFilhas: WaitingListEntry\n\nPrimeira PENDING → NOTIFIED.\nPreserva ordem de chegada.\nNão renotifica entradas NOTIFIED.\nNão reserva o lugar.", "originalText": "WaitingList — raiz separada de Event\nUma fila por event_id + section_id\nFilhas: WaitingListEntry\n\nPrimeira PENDING → NOTIFIED.\nPreserva ordem de chegada.\nNão renotifica entradas NOTIFIED.\nNão reserva o lugar.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "spot-offered", "type": "rectangle", "x": 1320, "y": 710, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#f7ceb2", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 32, "version": 1, "versionNonce": 32, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "spot-offered-text", "type": "text", "x": 1335, "y": 730, "width": 320, "height": 160, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 33, "version": 1, "versionNonce": 33, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "Lugar oferecido ao cliente da fila\nSpotOfferedToWaitingCustomer\n\ncustomer_id, event_id,\nsection_id, spot_id\nEvento de domínio da WaitingList.", "originalText": "Lugar oferecido ao cliente da fila\nSpotOfferedToWaitingCustomer\n\ncustomer_id, event_id,\nsection_id, spot_id\nEvento de domínio da WaitingList.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "join-title", "type": "text", "x": 30, "y": 1000, "width": 1100, "height": 55, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 34, "version": 1, "versionNonce": 34, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "2. Entrada na fila — fluxo independente, anterior à oferta\nWaitingList abaixo e acima representa a mesma raiz por evento + seção.", "originalText": "2. Entrada na fila — fluxo independente, anterior à oferta\nWaitingList abaixo e acima representa a mesma raiz por evento + seção.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "join-actor", "type": "rectangle", "x": 30, "y": 1100, "width": 180, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#ffe7a3", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 35, "version": 1, "versionNonce": 35, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "join-actor-text", "type": "text", "x": 45, "y": 1120, "width": 150, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 36, "version": 1, "versionNonce": 36, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Cliente\nCustomer\n\nValidado por ID.\nNão é filho\nda WaitingList.", "originalText": "Cliente\nCustomer\n\nValidado por ID.\nNão é filho\nda WaitingList.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "join-command", "type": "rectangle", "x": 250, "y": 1100, "width": 300, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#a9cfee", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 37, "version": 1, "versionNonce": 37, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "join-command-text", "type": "text", "x": 265, "y": 1120, "width": 270, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 38, "version": 1, "versionNonce": 38, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "Entrar na lista de espera\nWaitingListService.join(...)\nApplicationService.run(...)\n\nValida Customer, Event e seção.\nSeção sem lugar disponível.\nNão usa contador de reservas.\nNão notifica ninguém.", "originalText": "Entrar na lista de espera\nWaitingListService.join(...)\nApplicationService.run(...)\n\nValida Customer, Event e seção.\nSeção sem lugar disponível.\nNão usa contador de reservas.\nNão notifica ninguém.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "waiting-join", "type": "rectangle", "x": 590, "y": 1100, "width": 300, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#cec9bd", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 39, "version": 1, "versionNonce": 39, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "waiting-join-text", "type": "text", "x": 605, "y": 1120, "width": 270, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 40, "version": 1, "versionNonce": 40, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "WaitingList — raiz do agregado\nColeção via MyCollectionFactory\n\nWaitingListEntry:\ncustomer_id, status, position\nEntrada nasce PENDING.\nProíbe cliente PENDING duplicado.", "originalText": "WaitingList — raiz do agregado\nColeção via MyCollectionFactory\n\nWaitingListEntry:\ncustomer_id, status, position\nEntrada nasce PENDING.\nProíbe cliente PENDING duplicado.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "customer-joined", "type": "rectangle", "x": 930, "y": 1100, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#f7ceb2", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 41, "version": 1, "versionNonce": 41, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "customer-joined-text", "type": "text", "x": 945, "y": 1120, "width": 320, "height": 125, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 42, "version": 1, "versionNonce": 42, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Cliente entrou na lista\nCustomerJoinedWaitingList\n\nRegistrado pela WaitingList.\nNão dispara a oferta.", "originalText": "Cliente entrou na lista\nCustomerJoinedWaitingList\n\nRegistrado pela WaitingList.\nNão dispara a oferta.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "integration", "type": "rectangle", "x": 1320, "y": 1100, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#f7ceb2", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 43, "version": 1, "versionNonce": 43, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "integration-text", "type": "text", "x": 1335, "y": 1120, "width": 320, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 44, "version": 1, "versionNonce": 44, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "EVENTO DE INTEGRAÇÃO\nSpotOfferedToWaitingCustomerIntegrationEvent\n\npayload: customer_id, event_id,\nsection_id, spot_id\n\nMapeado em EventsModule.onModuleInit\nvia registerForIntegrationEvent.", "originalText": "EVENTO DE INTEGRAÇÃO\nSpotOfferedToWaitingCustomerIntegrationEvent\n\npayload: customer_id, event_id,\nsection_id, spot_id\n\nMapeado em EventsModule.onModuleInit\nvia registerForIntegrationEvent.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "query", "type": "rectangle", "x": 30, "y": 710, "width": 520, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#a9cec4", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 45, "version": 1, "versionNonce": 45, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "query-text", "type": "text", "x": 45, "y": 730, "width": 490, "height": 150, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 46, "version": 1, "versionNonce": 46, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Consulta da fila da seção\nWaitingListService.list(event_id, section_id)\n\nEntradas ordenadas por position, com seus status.\nSem alteração de estado ou notificação.\nNão é um terceiro comando de negócio.", "originalText": "Consulta da fila da seção\nWaitingListService.list(event_id, section_id)\n\nEntradas ordenadas por position, com seus status.\nSem alteração de estado ou notificação.\nNão é um terceiro comando de negócio.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "product-note", "type": "text", "x": 1710, "y": 1080, "width": 740, "height": 230, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 47, "version": 1, "versionNonce": 47, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "DECISÃO DE PRODUTO\nA política apenas avisa; lugar continua disponível.\nCompra pelo fluxo normal: quem chegar primeiro leva.\nSem reserva, prioridade ou expiração de oferta.\n\nFRONTEIRAS\nOrder, Event, SpotReservation, Customer e WaitingList\nsão agregados separados, referenciados por IDs.\nHandlers de domínio em processo; e-mails via fila.\nSem reembolso, concorrência, outbox ou e-mail real.", "originalText": "DECISÃO DE PRODUTO\nA política apenas avisa; lugar continua disponível.\nCompra pelo fluxo normal: quem chegar primeiro leva.\nSem reserva, prioridade ou expiração de oferta.\n\nFRONTEIRAS\nOrder, Event, SpotReservation, Customer e WaitingList\nsão agregados separados, referenciados por IDs.\nHandlers de domínio em processo; e-mails via fila.\nSem reembolso, concorrência, outbox ou e-mail real.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "context-boundary", "type": "rectangle", "x": 10, "y": 1430, "width": 2460, "height": 60, "angle": 0, "strokeColor": "#eab308", "backgroundColor": "#facc15", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 85, "groupIds": [], "seed": 48, "version": 1, "versionNonce": 48, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "boundary-text", "type": "text", "x": 30, "y": 1447, "width": 1100, "height": 30, "angle": 0, "strokeColor": "#713f12", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 49, "version": 1, "versionNonce": 49, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "FRONTEIRA DE CONTEXTO — evento de integração cruza para e-mails", "originalText": "FRONTEIRA DE CONTEXTO — evento de integração cruza para e-mails", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "emails-context", "type": "text", "x": 30, "y": 1530, "width": 1050, "height": 80, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 50, "version": 1, "versionNonce": 50, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "CONTEXTO: E-MAILS — apps/emails\nO transporte reutiliza a infraestrutura existente.\nNão há evento fictício de e-mail enviado.", "originalText": "CONTEXTO: E-MAILS — apps/emails\nO transporte reutiliza a infraestrutura existente.\nNão há evento fictício de e-mail enviado.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "transport", "type": "rectangle", "x": 1320, "y": 1580, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#dfc1c1", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 51, "version": 1, "versionNonce": 51, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "transport-text", "type": "text", "x": 1335, "y": 1600, "width": 320, "height": 180, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 52, "version": 1, "versionNonce": 52, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "Transporte entre contextos\n\nBull: integration-events\n→ IntegrationEventsPublisher\n→ RabbitMQ: amq.direct\nRouting key = nome do evento\nde integração.", "originalText": "Transporte entre contextos\n\nBull: integration-events\n→ IntegrationEventsPublisher\n→ RabbitMQ: amq.direct\nRouting key = nome do evento\nde integração.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "consumer", "type": "rectangle", "x": 1710, "y": 1580, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#c6baff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 53, "version": 1, "versionNonce": 53, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "consumer-text", "type": "text", "x": 1725, "y": 1600, "width": 320, "height": 150, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 54, "version": 1, "versionNonce": 54, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "Reação no contexto de e-mails\nConsumerService.handleSpotOffered\n\n@RabbitSubscribe\nFila própria: emails-spot-offered.\nPreserva a assinatura de parceiros.\nSem alterar a compra.", "originalText": "Reação no contexto de e-mails\nConsumerService.handleSpotOffered\n\n@RabbitSubscribe\nFila própria: emails-spot-offered.\nPreserva a assinatura de parceiros.\nSem alterar a compra.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
    { "id": "log", "type": "rectangle", "x": 2100, "y": 1580, "width": 350, "height": 220, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "#dfc1c1", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "seed": 55, "version": 1, "versionNonce": 55, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "log-text", "type": "text", "x": 2115, "y": 1600, "width": 320, "height": 150, "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 56, "version": 1, "versionNonce": 56, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "Efeito observável\nconsole.log estruturado\n\nIdentifica customer_id e section_id.\nProva do consumo da oferta.\nNão envia e-mail real.", "originalText": "Efeito observável\nconsole.log estruturado\n\nIdentifica customer_id e section_id.\nProva do consumo da oferta.\nNão envia e-mail real.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25 },
