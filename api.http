### Executar em ordem após preparar o banco e iniciar API e apps/emails.
# As respostas capturam os IDs automaticamente no HTTP Client do IntelliJ.
GET http://localhost:3000

###
GET http://localhost:3000/partners

###
POST http://localhost:3000/partners
Content-Type: application/json

{
    "name": "Partner 1"
}

> {%
    client.global.set("partner_id", response.body.id);
%}

###
GET http://localhost:3000/customers

###
POST http://localhost:3000/customers
Content-Type: application/json

{
    "name": "Customer A",
    "cpf": "592.110.870-74"
}

> {%
    client.global.set("customer_id", response.body.id);
%}

### Cliente B: vai entrar na lista de espera.
POST http://localhost:3000/customers
Content-Type: application/json

{
    "name": "Customer B",
    "cpf": "703.758.870-91"
}

> {%
    client.global.set("waiting_customer_id", response.body.id);
%}

###
GET http://localhost:3000/events

###
POST http://localhost:3000/events
Content-Type: application/json

{
    "name": "Event 1",
    "description": "Description 1",
    "date": "2020-01-01T00:00:00.000Z",
    "partner_id": "{{partner_id}}"
}

> {%
    client.global.set("event_id", response.body.id);
%}

###
GET http://localhost:3000/events/{{event_id}}/sections

###
POST http://localhost:3000/events/{{event_id}}/sections
Content-Type: application/json

{
    "name": "Section 1",
    "description": "Description 1",
    "total_spots": 1,
    "price": 200
}

> {%
    client.global.set("section_id", response.body.sections[0].id);
    client.global.set("spot_id", response.body.sections[0].spots[0].id);
%}

###
PUT http://localhost:3000/events/{{event_id}}/publish-all

###
PUT http://localhost:3000/events/{{event_id}}/sections/{{section_id}}
Content-Type: application/json

{
    "name": "Section 1 updateddddd",
    "description": "Description 1 updatedddd"
}

###
GET http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/spots

###
PUT http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/spots/{{spot_id}}
Content-Type: application/json

{
    "location": "Location 1 updateddddqqqq"
}

###
GET http://localhost:3000/events/{{event_id}}/orders

###
POST http://localhost:3000/events/{{event_id}}/orders
Content-Type: application/json

{
    "customer_id": "{{customer_id}}",
    "section_id": "{{section_id}}",
    "spot_id": "{{spot_id}}",
    "card_token": "tok_visa"
}

> {%
    client.global.set("order_id", response.body.id);
    client.test("Pedido pago", function () {
        client.assert(response.body.status === 1, "Esperado PAID = 1");
    });
%}

### Seção esgotada: o único lugar está reservado.
GET http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/spots

> {%
    client.test("Lugar reservado", function () {
        client.assert(response.body[0].reserved === true, "Esperado reserved = true");
    });
%}

### Entrar na fila com o cliente B.
POST http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/waiting-list
Content-Type: application/json

{
    "customer_id": "{{waiting_customer_id}}"
}

> {%
    client.test("Entrada pendente", function () {
        client.assert(response.body.status === 0, "Esperado PENDING = 0");
    });
%}

### Consultar a fila antes do cancelamento.
GET http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/waiting-list

> {%
    client.test("Cliente B pendente", function () {
        client.assert(response.body.length === 1, "Esperada uma entrada");
        client.assert(response.body[0].status === 0, "Esperado PENDING = 0");
    });
%}

### Um único comando dispara liberação, notificação e integração.
POST http://localhost:3000/events/{{event_id}}/orders/{{order_id}}/cancel

> {%
    client.test("Pedido cancelado", function () {
        client.assert(response.body.status === 2, "Esperado CANCELLED = 2");
    });
%}

### Lugar disponível novamente, sem reserva para o cliente notificado.
GET http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/spots

> {%
    client.test("Lugar liberado", function () {
        client.assert(response.body[0].reserved === false, "Esperado reserved = false");
    });
%}

### Cliente B notificado; verificar também o log de apps/emails.
GET http://localhost:3000/events/{{event_id}}/sections/{{section_id}}/waiting-list

> {%
    client.test("Cliente B notificado", function () {
        client.assert(response.body[0].customer_id === client.global.get("waiting_customer_id"), "Cliente incorreto");
        client.assert(response.body[0].status === 1, "Esperado NOTIFIED = 1");
    });
%}

### Consultar o pedido com seu status.
GET http://localhost:3000/events/{{event_id}}/orders

# No MySQL: SELECT type_name FROM stored_event;
# Esperados: CustomerJoinedWaitingList, OrderCancelled,
# EventSpotReleased e SpotOfferedToWaitingCustomer.